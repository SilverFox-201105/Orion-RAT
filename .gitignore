# ===== .NET / Visual Studio build outputs =====
bin/
obj/
x64/
Debug/
Release/
out/
.vs/

# ===== IDE / temp files =====
*.user
*.suo
*.userosscache
*.sln.docstates
*.ide
*.cache
*.log
Thumbs.db
Desktop.ini

# ===== Compiled artifacts =====
*.pdb
*.ilk
*.exp
*.lib
*.tlog
*.lastbuildstate

# ===== Archives / backups (git replaces these) =====
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# ===== Built plugin packages (generated by _website_build_tools) =====
*.Orion

# ===== Plugin deploy output (regenerates on build) =====
Plugin_Bin/

# ===== Orion plugin contract assemblies =====
# Reference assemblies built from Orion.Server / Orion.Common source.
# Regenerate with:  PluginDev\regenerate-contracts.cmd
# (run once after cloning, and whenever the public plugin API changes)
PluginDev/Libs-Contract/*.dll
PluginDev/Libs-Contract/net48/*.dll
PluginDev/*/libs/*.dll
PluginDev/*/libs/net48/*.dll

# ===== Embedded Python venv for LsassDump plugin (runtime, not source) =====
PluginDev/LsassDump/python/
PluginDev/Plugin_Bin/LsassDump/python/

# ===== Python caches / environments =====
__pycache__/
*.pyc
.venv/
venv/
env/

# ===== Node tooling (if used by web build) =====
node_modules/

# ===== Deferred assembly payload =====
# Shipped to clients by DeferredAssemblyProvider. Restored from NuGet during build
# (Orion.Server.csproj -> StageDeferredAssemblies target) instead of being committed.
Orion.Server/DeferredAssemblies/

# ===== Externally obtained binaries (drivers / native payloads) =====
# Each folder carries a README.md with the expected file name, size and SHA-256.
PluginDev/LsassDump/driver/*.sys
PluginDev/BrowserDecrypt/payload/*.dll

# ===== User-supplied frpc.exe (official FRP client, chosen by user in Settings) =====
# Orion no longer ships a frpc binary. The user selects an official .zip in Settings;
# frpc.exe is extracted to FRPC/ at runtime and must never be committed.
FRPC/

# ===== Diagnostic scratch (frp source dumps, capture scripts, test binaries) =====
# Created during FRP protocol investigation; not part of the project.
_src_ref/

# WorkBuddy 内部数据（含 AI 工作日志/记忆，禁止入库）
.workbuddy/

# 按用户要求：Docs 文档不随源码发布
Docs/
