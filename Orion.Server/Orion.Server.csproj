	<!-- ===== Deferred assemblies payload =====
	     Orion.Server downloads these DLLs to connected clients on demand
	     (see Utilities\DeferredAssemblyProvider.cs), so the versions below must stay
	     in sync with Orion.Client's PackageReferences.
	     They are deliberately NOT committed as binaries: build restores them from
	     NuGet via GeneratePathProperty and stages them into the output folder
	     (target StageDeferredAssemblies). Nothing is copied into the source tree.
	     Note: Orion.Client.csproj still writes a copy into Orion.Server\DeferredAssemblies\
	     (target PrepareDeferredAssemblies). That folder is gitignored and no longer feeds
	     the build - StageDeferredAssemblies is authoritative and additionally covers
	     Gma.System.MouseKeyHook.dll, which the client-side globs never matched. -->
	<ItemGroup>
		<PackageReference Include="AForge" Version="2.2.5" ExcludeAssets="all" GeneratePathProperty="true" NoWarn="NU1701" />
		<PackageReference Include="AForge.Video" Version="2.2.5" ExcludeAssets="all" GeneratePathProperty="true" NoWarn="NU1701" />
		<PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" ExcludeAssets="all" GeneratePathProperty="true" NoWarn="NU1701" />
		<PackageReference Include="SharpDX" Version="4.2.0" ExcludeAssets="all" GeneratePathProperty="true" />
		<PackageReference Include="SharpDX.D3DCompiler" Version="4.2.0" ExcludeAssets="all" GeneratePathProperty="true" />
		<PackageReference Include="SharpDX.DXGI" Version="4.2.0" ExcludeAssets="all" GeneratePathProperty="true" />
		<PackageReference Include="SharpDX.Direct2D1" Version="4.2.0" ExcludeAssets="all" GeneratePathProperty="true" />
		<PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" ExcludeAssets="all" GeneratePathProperty="true" />
		<PackageReference Include="SharpDX.Mathematics" Version="4.2.0" ExcludeAssets="all" GeneratePathProperty="true" />
	</ItemGroup>
	<Target Name="StageDeferredAssemblies" AfterTargets="Build">
		<ItemGroup>
			<_DeferredAssembly Include="$(PkgAForge)\lib\AForge.dll">
				<PayloadName>AForge.dll</PayloadName>
			</_DeferredAssembly>
			<_DeferredAssembly Include="$(PkgAForge_Video)\lib\AForge.Video.dll">
				<PayloadName>AForge.Video.dll</PayloadName>
			</_DeferredAssembly>
			<_DeferredAssembly Include="$(PkgAForge_Video_DirectShow)\lib\AForge.Video.DirectShow.dll">
				<PayloadName>AForge.Video.DirectShow.dll</PayloadName>
			</_DeferredAssembly>
			<_DeferredAssembly Include="$(PkgMouseKeyHook)\lib\net48\Gma.System.MouseKeyHook.dll">
				<PayloadName>Gma.System.MouseKeyHook.dll</PayloadName>
			</_DeferredAssembly>
			<_DeferredAssembly Include="$(PkgNAudio_Core)\lib\netstandard2.0\NAudio.Core.dll">
				<PayloadName>NAudio.Core.dll</PayloadName>
			</_DeferredAssembly>
			<_DeferredAssembly Include="$(PkgNAudio_Wasapi)\lib\netstandard2.0\NAudio.Wasapi.dll">
				<PayloadName>NAudio.Wasapi.dll</PayloadName>
			</_DeferredAssembly>
			<_DeferredAssembly Include="$(PkgNAudio_WinForms)\lib\net472\NAudio.WinForms.dll">
				<PayloadName>NAudio.WinForms.dll</PayloadName>
			</_DeferredAssembly>
			<_DeferredAssembly Include="$(PkgNAudio_WinMM)\lib\netstandard2.0\NAudio.WinMM.dll">
				<PayloadName>NAudio.WinMM.dll</PayloadName>
			</_DeferredAssembly>
			<_DeferredAssembly Include="$(PkgSharpDX)\lib\net45\SharpDX.dll">
				<PayloadName>SharpDX.dll</PayloadName>
			</_DeferredAssembly>
			<_DeferredAssembly Include="$(PkgSharpDX_D3DCompiler)\lib\net45\SharpDX.D3DCompiler.dll">
				<PayloadName>SharpDX.D3DCompiler.dll</PayloadName>
			</_DeferredAssembly>
			<_DeferredAssembly Include="$(PkgSharpDX_DXGI)\lib\net45\SharpDX.DXGI.dll">
				<PayloadName>SharpDX.DXGI.dll</PayloadName>
			</_DeferredAssembly>
			<_DeferredAssembly Include="$(PkgSharpDX_Direct2D1)\lib\net45\SharpDX.Direct2D1.dll">
				<PayloadName>SharpDX.Direct2D1.dll</PayloadName>
			</_DeferredAssembly>
			<_DeferredAssembly Include="$(PkgSharpDX_Direct3D11)\lib\net45\SharpDX.Direct3D11.dll">
				<PayloadName>SharpDX.Direct3D11.dll</PayloadName>
			</_DeferredAssembly>
			<_DeferredAssembly Include="$(PkgSharpDX_Mathematics)\lib\net45\SharpDX.Mathematics.dll">
				<PayloadName>SharpDX.Mathematics.dll</PayloadName>
			</_DeferredAssembly>
		</ItemGroup>
		<Error Text="Deferred assembly not found in the NuGet cache: %(_DeferredAssembly.Identity). Run 'dotnet restore Orion.Server.csproj' first." Condition="!Exists('%(_DeferredAssembly.Identity)')" />
		<Copy SourceFiles="@(_DeferredAssembly)" DestinationFiles="@(_DeferredAssembly->'$(OutDir)DeferredAssemblies\%(PayloadName)')" SkipUnchangedFiles="true" />
	</Target>
