<Project Sdk="Microsoft.NET.Sdk">

  <!-- 服务端插件模板：目标框架必须与 Orion.Server 一致（net9.0-windows） -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- 输出名改成你的插件名（不要以 .Client 结尾） -->
    <AssemblyName>MyServerPlugin</AssemblyName>
    <RootNamespace>MyServerPlugin</RootNamespace>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 从开发者 SDK 的 Libs-Contract\ 拷贝契约程序集到本目录的 libs\ 下（仅元数据、不含实现，用于保护核心源码）。
         服务端主程序集是 Orion.dll（不是 Orion.Server.dll）。
         ⚠️ 不要用 Orion 运行目录里的真实 Orion.dll / Orion.Common.dll 替换它们。 -->
    <Reference Include="Orion">
      <HintPath>libs\Orion.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Orion.Common">
      <HintPath>libs\Orion.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Orion 运行时已自带，不要拷贝到输出目录 -->
    <PackageReference Include="MessagePack" Version="3.1.7">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    可选：编译后自动拷贝到 Orion 的插件目录，配合热重载实现"改代码即生效"。
    把下面的路径改成你本机的 Orion.Server 输出目录。
  <Target Name="CopyToOrionPlugins" AfterTargets="Build">
    <PropertyGroup>
      <OrionPluginDir>C:\Path\To\Orion.Server\bin\Debug\net9.0-windows\Plugins\MyServerPlugin\</OrionPluginDir>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(OrionPluginDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\plugin.json" DestinationFolder="$(OrionPluginDir)" />
  </Target>
  -->

</Project>
