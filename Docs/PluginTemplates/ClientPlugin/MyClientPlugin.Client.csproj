<Project Sdk="Microsoft.NET.Sdk">

  <!--
    客户端插件模板：目标框架必须与 Orion.Client 一致（net48）。

    两个硬性命名要求：
      1. AssemblyName 必须以 ".Client" 结尾 → 产出 MyClientPlugin.Client.dll
      2. 服务端 ClientPluginCatalog 只认文件名以 ".Client.dll" 结尾的程序集
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <AssemblyName>MyClientPlugin.Client</AssemblyName>
    <RootNamespace>MyClientPlugin.ClientModule</RootNamespace>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 从开发者 SDK 的 Libs-Contract\net48\ 拷贝契约程序集 Orion.Common.dll 到 libs\net48\（仅元数据、不含实现） -->
    <Reference Include="Orion.Common">
      <HintPath>libs\net48\Orion.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    ⚠️⚠️ 依赖约束（务必阅读教程 5.4 节）⚠️⚠️

    这个 DLL 除了在被控端（net48）执行之外，还会被【服务端（net9）】
    Assembly.Load 用来读取 PluginId / Version。

    因此：
      ✅ 只允许引用 Orion.Common + mscorlib / System / System.Core
      ❌ 禁止引用 System.Windows.Forms / System.Drawing / System.Management
      ❌ 禁止引用 NAudio / SharpDX / AForge / Newtonsoft.Json 等（不会跟着下发）
      ✅ 需要 Win32 API 时用 DllImport
      ✅ 需要 WMI 时起 cmd /c wmic ... 读标准输出

    如果你确实需要重依赖，用 Costura.Fody 把依赖合并进单文件。
  -->

</Project>
